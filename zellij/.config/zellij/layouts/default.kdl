layout {
    default_tab_template {
        children
        pane size=1 borderless=true split_direction="vertical" {
            // plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
            plugin location="https://github.com/solomonrosemite/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left   "{mode} #[fg=#89B4FA,bold]{session}"
                format_center   "{tabs}"
                format_right  "{datetime}"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#6C7086]{char}"
                border_position "top"

                hide_frame_for_single_pane "true"

                mode_normal        "#[bg=blue] "
                mode_locked        "#[bg=#ef5f6b]lock "
                mode_resize        "#[bg=#ffc387]resize "
                mode_pane          "#[bg=#ffc387]pane "
                mode_tab           "#[bg=#ffc387]tab "
                mode_scroll        "#[bg=#ffc387]scroll "
                mode_enter_search  "#[bg=#ffc387]search "
                mode_search        "#[bg=#ffc387]search "
                mode_rename_tab    "#[bg=#ffc387]tab "
                mode_rename_pane   "#[bg=#ffc387]pane "
                mode_session       "#[bg=#ffc387]session "
                mode_move          "#[bg=#ffc387]move "
                mode_prompt        "#[bg=#ffc387]prompt "
                mode_tmux          "#[bg=#ffc387]tmux "

                tab_normal   "#[fg=#6C7086] [{custom_index}] {name}"
                tab_active   "#[fg=#9399B2,bold] [{custom_index}] {name}"

                tab_fullscreen_indicator "□ "
                tab_floating_indicator   "󰉈 "

                datetime        "#[fg=#6C7086,bold] {format} "
                datetime_format "%H:%M"
                datetime_timezone "Europe/Berlin"
            }
        }
    }
}
