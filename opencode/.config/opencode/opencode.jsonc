{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "plan",
    "model": "minimax/minimax-m2.1",
    // "small_model": "anthropic/claude-haiku-4-5",
    "enabled_providers": [
        "openrouter"
    ],
    "permission": {
        "question": "deny", // just dont like em. ask me in the chat
        "bash": {
            "*": "allow",
            "rm": "deny",
        }
    },
    // "instructions": ["CONTRIBUTING.md", "docs/guidelines.md", ".cursor/rules/*.md"]
    "mcp": {
        "augment-context-engine": {
            "type": "local",
            "command": [
                "auggie",
                "--mcp"
            ],
            "enabled": false
        },
        "orchestrator": {
            "type": "remote",
            "enabled": false,
            "url": "http://localhost:3000/mcp",
            "headers": {
                "Authorization": "Bearer abc-solo"
            }
        },
        "linear": {
            "type": "remote",
            "url": "https://mcp.linear.app/mcp",
            "enabled": true,
            "headers": {
                "Authorization": "Bearer {env:LINEAR_API_KEY}"
            }
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            },
            "enabled": true
        }
    },
    // Disabling all MCP servers and exclusively making it available via sub-agents forces open code to
    // (1) use these sub-agents, which circumvents the problem of the agent being overwhelmed by too many different MCP tools and
    // (2) also prevents filling up the main agent's context window.
    // (the * wildcard for some reason is very important. without it does not get disabled)
    "tools": {
        "linear*": false,
        "context7*": false
    },
    "agent": {
        "linear": {
            "description": "Linear ticket management",
            "mode": "subagent",
            "prompt": "You have access to linear ticket management and often get asked to retrieve or do something in Linear. Using the tools available to you.",
            "tools": {
                "linear*": true,
                "bash": false
            }
        },
        "context7": {
            "description": "Fetch up to date documentation from Context7",
            "mode": "subagent",
            "prompt": "Get the latest documentation for various projects and libraries.",
            "tools": {
                "context7*": true,
                "bash": false
            }
        },
        // excerpt from https://opencode.ai/docs/agents/
        // Temperature values typically range from 0.0 to 1.0:
        // 0.0-0.2: Very focused and deterministic responses, ideal for code analysis and planning
        // 0.3-0.5: Balanced responses with some creativity, good for general development tasks
        // 0.6-1.0: More creative and varied responses, useful for brainstorming and exploration
        "build": {
            "mode": "primary",
            "color": "#52a7fa",
        },
        "plan": {
            "mode": "primary",
            "color": "#9c76ca",
            "tools": {
                "write": false,
                "edit": false,
                "bash": false
            }
        },
        "brainstorm": {
            "temperature": 0.7,
            // "prompt": "{file:./prompts/creative.txt}"
        },
    },
    "keybinds": {
        "leader": "cmd+y",
        "session_child_cycle": "right",
        "session_child_cycle_reverse": "left",
        "session_parent": "up",
    }
}
